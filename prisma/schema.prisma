}

model ServiceOrderItem {
  id             String  @id @default(cuid())
  serviceOrderId String  @map("service_order_id")
  serviceTypeId  String? @map("service_type_id")
  productId      String? @map("product_id")
  tipo           String // SERVICO, PECA
  descricao      String
  quantidade     Decimal @db.Decimal(10, 3)
  precoUnitario  Decimal @map("preco_unitario") @db.Decimal(10, 2)
  valorTotal     Decimal @map("valor_total") @db.Decimal(10, 2)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serviceType  ServiceType? @relation("serviceTypeItems", fields: [serviceTypeId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id])

  @@map("service_order_items")
}

model Professional {
  id                 String   @id @default(cuid())
  storeId            String   @map("store_id")
  nome               String
  telefone           String?
  cor                String?  @default("#6366f1") // cor no calendário
  cargo              String?
  comissaoPercentual Decimal? @default(0) @map("comissao_percentual") @db.Decimal(5, 2)
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("professionals")
}

model Appointment {
  id             String   @id @default(cuid())
  storeId        String   @map("store_id")
  customerId     String   @map("customer_id")
  professionalId String?  @map("professional_id")
  data           DateTime // Data e hora do agendamento
  duracaoMinutos Int      @default(60) @map("duracao_minutos")
  servico        String? // Nome do serviço agendado
  observacoes    String?  @db.Text
  // Status: AGENDADO | CONFIRMADO | EM_ANDAMENTO | CONCLUIDO | CANCELADO | NAO_COMPARECEU
  status         String   @default("AGENDADO")
  valorCobrado   Decimal  @default(0) @map("valor_cobrado") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@map("appointments")
}

// ============================================================
// FINANÇAS PESSOAIS (PF) - MÓDULO ISOLADO
// ============================================================

model PersonalCategory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  nome      String
  tipo      String // 'ENTRADA' | 'SAIDA'
  icone     String?  @default("💵")
  cor       String?  @default("#6366f1")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PersonalTransaction[]
  budgets      PersonalBudget[]

  @@map("personal_categories")
}

model PersonalTransaction {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  categoryId      String    @map("category_id")
  walletId        String?   @map("wallet_id")
  tipo            String // 'ENTRADA' | 'SAIDA'
  valor           Decimal   @db.Decimal(12, 2)
  descricao       String?
  data            DateTime  @default(now()) @db.Timestamptz()
  dataCompetencia DateTime? @map("data_competencia")
  pago            Boolean   @default(false)
  formaPagamento  String?   @map("forma_pagamento")
  recorrente      Boolean   @default(false)
  parcelas        Int?
  observacoes     String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category PersonalCategory @relation(fields: [categoryId], references: [id])
  wallet   PersonalWallet?  @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@map("personal_transactions")
}

model PersonalWallet {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  nome      String
  icone     String?  @default("💳")
  cor       String?  @default("#6366f1")
  saldo     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PersonalTransaction[]

  @@map("personal_wallets")
}

model PersonalBudget {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  categoryId  String   @map("category_id")
  mes         Int // 1-12
  ano         Int
  valorLimite Decimal  @map("valor_limite") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category PersonalCategory @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, mes, ano])
  @@map("personal_budgets")
}

// ============================================================
// MÓDULO OPERACIONAL PET — Modelos Independentes
// ============================================================

model PetTutor {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  nome        String
  telefone    String?
  email       String?
  endereco    String?
  bairro      String?
  cidade      String?
  cep         String?
  observacoes String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pets Pet[]

  @@index([storeId])
  @@map("pet_tutors")
}

model Pet {
  id             String    @id @default(cuid())
  storeId        String    @map("store_id")
  tutorId        String    @map("tutor_id")
  nome           String
  especie        String
  raca           String?
  porte          String?
  sexo           String?
  dataNascimento DateTime? @map("data_nascimento") @db.Date
  cor            String?
  observacoes    String?   @db.Text
  adotado        Boolean   @default(false)
  dataAdocao     DateTime? @map("data_adocao")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tutor         PetTutor          @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  serviceOrders PetServiceOrder[]
  vaccines      PetVaccine[]
  weights       PetWeight[]

  @@map("pets")
}

model PetVaccine {
  id            String    @id @default(cuid())
  storeId       String    @map("store_id")
  petId         String    @map("pet_id")
  nome          String
  tipo          String    @default("VACINA") // VACINA | VERMIFUGO
  dose          String?
  dataAplicacao DateTime  @map("data_aplicacao") @db.Date
  proximaDose   DateTime? @map("proxima_dose") @db.Date
  observacoes   String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([storeId, petId])
  @@map("pet_vaccines")
}

model PetWeight {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  petId       String   @map("pet_id")
  pesoKg      Decimal  @map("peso_kg") @db.Decimal(5, 2)
  dataPesagem DateTime @default(now()) @map("data_pesagem")
  observacoes String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([storeId, petId])
  @@map("pet_weights")
}

model PetServiceCatalog {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  nome        String
  descricao   String?  @db.Text
  preco       Decimal  @db.Decimal(10, 2)
  categoria   String?
  tipoDuracao String   @default("INDETERMINADO") @map("tipo_duracao")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items PetServiceOrderItem[]

  @@index([storeId])
  @@map("pet_service_catalog")
}

model PetServiceOrder {
  id             String    @id @default(cuid())
  storeId        String    @map("store_id")
  petId          String    @map("pet_id")
  dataEntrada    DateTime  @map("data_entrada")
  dataSaida      DateTime? @map("data_saida")
  horaInicio     String?   @map("hora_inicio")
  horaFim        String?   @map("hora_fim")
  dataConclusao  DateTime? @map("data_conclusao")
  status         String    @default("AGENDADO")
  valorTotal     Decimal   @map("valor_total") @db.Decimal(10, 2)
  desconto       Decimal   @default(0) @map("desconto") @db.Decimal(10, 2)
  valorFinal     Decimal   @map("valor_final") @db.Decimal(10, 2)
  formaPagamento String?   @map("forma_pagamento")
  ultimaCobranca DateTime? @map("ultima_cobranca")
  recorrente     Boolean   @default(false)
  periodicidadeMeses Int   @default(1) @map("periodicidade_meses")
  observacoes    String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  pet   Pet                   @relation(fields: [petId], references: [id])
  items PetServiceOrderItem[]

  @@index([storeId, petId])
  @@map("pet_service_orders")
}

model PetServiceOrderItem {
  id             String  @id @default(cuid())
  serviceOrderId String  @map("service_order_id")
  catalogItemId  String  @map("catalog_item_id")
  quantidade     Int     @default(1)
  precoUnitario  Decimal @map("preco_unitario") @db.Decimal(10, 2)
  valorTotal     Decimal @map("valor_total") @db.Decimal(10, 2)

  order   PetServiceOrder   @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  catalog PetServiceCatalog @relation(fields: [catalogItemId], references: [id])

  @@index([serviceOrderId, catalogItemId])
  @@map("pet_service_order_items")
}
