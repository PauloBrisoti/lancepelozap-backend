# ============================================================
# .env.example — Variáveis para Docker
# Copie para backend/.env e preencha os valores
# ============================================================

# --- Banco de Dados (PostgreSQL EXTERNO) ---
# Local: postgresql://saas_admin:SENHA@localhost:5432/saas_db
# Produção: postgresql://saas_admin:SENHA@172.16.1.3:5432/saas_db
DATABASE_URL="postgresql://saas_admin:SUA_SENHA@localhost:5432/saas_db"

# --- JWT (gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ---
JWT_SECRET="GERE_UMA_CHAVE_FORTE_DE_64_BYTES"

# --- Servidor ---
PORT=3001
NODE_ENV=production
TZ=America/Sao_Paulo
TIMEZONE=America/Sao_Paulo

# --- Backups ---
BACKUP_DIR=/opt/backups/saas
BACKUP_RETENTION_DAYS=7

# --- Mercado Pago ---
MP_ACCESS_TOKEN="APP_USR-SEU_TOKEN"
MP_WEBHOOK_SECRET="SEU_WEBHOOK_SECRET"

# --- Google Gemini AI ---
GEMINI_API_KEY="SUA_GEMINI_KEY"

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="saas-comprovantes"
R2_PUBLIC_URL=""

# --- Super Admin ---
SUPER_ADMIN_SECRET="GERE_UMA_CHAVE_FORTE"

# --- SMTP ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@lancepelozap.com.br
SMTP_PASS="SUA_SENHA_DO_EMAIL"
SMTP_FROM=contato@lancepelozap.com.br

# --- Slack Webhook ---
SLACK_WEBHOOK_URL=""

# --- Alertas e performance ---
ALERT_WEBHOOK_URL=""
QUERY_SLOW_MS=500
