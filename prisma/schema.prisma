  dataPedido        DateTime  @default(now()) @map("data_pedido")
  dataPrevisao      DateTime? @map("data_previsao")
  valorTotalBruto   Decimal   @map("valor_total_bruto") @db.Decimal(10, 2)
  valorDesconto     Decimal   @default(0) @map("valor_desconto") @db.Decimal(10, 2)
  valorTotalLiquido Decimal   @map("valor_total_liquido") @db.Decimal(10, 2)
  valorVenda        Decimal?  @map("valor_venda") @db.Decimal(10, 2)
  valorEntrada      Decimal?  @map("valor_entrada") @db.Decimal(10, 2)
  walletIdEntrada   String?   @map("wallet_id_entrada")
  numeroParcelas    Int?      @map("numero_parcelas")
