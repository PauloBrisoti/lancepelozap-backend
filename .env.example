# ============================================================
# .env.example — SaaS Gestão Modular — Backend
# Copie para .env e preencha com os valores reais
# NUNCA commite o .env no git!
# ============================================================

# --- Banco de Dados (PostgreSQL) ---
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL="postgresql://saas_admin:SUA_SENHA@localhost:5432/saas_db"

# --- Autenticação JWT ---
# Gere: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# --- Servidor ---
PORT=3001
NODE_ENV=production

# --- Cloudflare R2 (Storage) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="saas-comprovantes"
R2_PUBLIC_URL=""

# --- Mercado Pago ---
MP_ACCESS_TOKEN=""
# Segredo do webhook (painel MP > Suas integrações > Notificações/Webhooks).
# Necessário para validar a assinatura das notificações de pagamento/assinatura.
MP_WEBHOOK_SECRET=""

# --- SMTP (Hostinger) ---
# Porta 465 (SSL) ou 587 (TLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@lancepelozap.com.br
SMTP_PASS=
SMTP_FROM=contato@lancepelozap.com.br

# --- Google Gemini AI ---
GEMINI_API_KEY=""

# --- Super Admin ---
SUPER_ADMIN_SECRET=""
