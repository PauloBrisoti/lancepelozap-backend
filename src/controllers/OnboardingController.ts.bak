import { Request, Response } from 'express';
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';
import { prisma } from '../lib/prisma';

export const registerTenant = async (req: Request, res: Response): Promise<void> => {
  try {
    const { nomeFantasia, telefoneWhatsapp, nomeResponsavel, email, senha } = req.body;

    if (!nomeFantasia || !email || !senha) {
      res.status(400).json({ error: 'Campos obrigatórios: Nome da Loja, Email e Senha' });
      return;
    }

    // 1. Verificar se o e-mail já existe (como usuário)
    const existingUser = await prisma.user.findUnique({ where: { email } });
    if (existingUser) {
      res.status(400).json({ error: 'E-mail já está em uso' });
      return;
    }

    // Hash da senha
    const hashedPassword = await bcrypt.hash(senha, 10);

    // 2. Criar a Loja (Tenant), o Dono (User ADMIN) e a Assinatura Trial numa transaction
    const transactionResult = await prisma.$transaction(async (tx) => {
      // 2.1. Criar Tenant
      const newTenant = await tx.tenant.create({
        data: {
          nomeFantasia,
          telefoneWhatsapp: telefoneWhatsapp || null,
          emailContato: email,
        },
      });

      // 2.2. Criar Usuário Admin
      const newUser = await tx.user.create({
        data: {
          email,
          senha: hashedPassword,
          nome: nomeResponsavel || 'Dono da Loja',
          role: 'ADMIN',
          storeId: newTenant.id,
        },
      });

      // 2.3. Criar a Assinatura Trial (7 dias)
      const validade = new Date();
      validade.setDate(validade.getDate() + 7); // Daqui a 7 dias
      
      const newSubscription = await tx.subscription.create({
        data: {
          storeId: newTenant.id,
          plano: 'PRO', // O plano de teste inicial
          statusPagamento: 'TRIAL',
          dataVencimento: validade,
        },
      });

      return { newTenant, newUser, newSubscription };
    });

    // 3. Fazer o "Auto-login", gerando o Token JWT para o novo usuário
    const token = jwt.sign(
      { 
        userId: transactionResult.newUser.id, 
        storeId: transactionResult.newTenant.id,
        role: transactionResult.newUser.role
      },
      process.env.JWT_SECRET || 'fallback_secret',
      { expiresIn: '1d' }
    );

    // 4. Setar o cookie e retornar os dados
    res.cookie('token', token, {
      httpOnly: true,
      secure: process.env.NODE_ENV === 'production',
      sameSite: 'lax',
      maxAge: 24 * 60 * 60 * 1000 // 1 dia
    });

    res.status(201).json({
      message: 'Loja criada com sucesso',
      user: {
        id: transactionResult.newUser.id,
        nome: transactionResult.newUser.nome,
        email: transactionResult.newUser.email,
        role: transactionResult.newUser.role,
        storeId: transactionResult.newTenant.id
      }
    });
  } catch (error) {
    console.error('Erro no registro do tenant:', error);
    res.status(500).json({ error: 'Erro interno ao registrar loja' });
  }
};
