  customer              Customer?              @relation(fields: [customerId], references: [id])
  receivables           AccountReceivable[]
  saleItems             SaleItem[]
  financialTransactions FinancialTransaction[]
  productReturns        ProductReturn[]

  @@map("sales")
}

