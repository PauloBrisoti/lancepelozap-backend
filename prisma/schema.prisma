// ============================================================
// schema.prisma — SaaS Gestão Modular (Fase 1: Hierarquia Client > Control > Store)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // A DATABASE_URL é configurada no ambiente
}

// ============================================================
// SAAS CORE — Donos de Conta e Planos
// ============================================================

model Plan {
  id           String   @id @default(cuid())
  nome         String
  precoMensal  Decimal  @map("preco_mensal") @db.Decimal(10, 2)
  maxControls  Int      @default(1) @map("max_controls")
  maxStores    Int      @default(1) @map("max_stores")
  maxEmployees Int      @default(3) @map("max_employees")
  features     String?  @map("features") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Client {
  id                    String    @id @default(cuid())
  nomeCompleto          String    @map("nome_completo")
  cnpjCpf               String?   @unique @map("cnpj_cpf")
  email                 String    @unique
  telefoneWhatsapp      String?   @map("telefone_whatsapp")
  status                String    @default("ATIVO")
  allowConsolidatedView Boolean   @default(false) @map("allow_consolidated_view")
  aceiteTermosData      DateTime? @map("aceite_termos_data")
  dadosCompletos        Boolean   @default(false) @map("dados_completos")

  // Endereço
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isDemo    Boolean   @default(false) @map("is_demo")

  controls          Control[]
  subscriptions     Subscription[]
  clientUsers       ClientUser[]
  excecoesBloqueio  ExcecaoBloqueio[]
  saasAuditLogs     SaasAuditLog[]
  internalRoles     InternalRole[]

  @@map("clients")
}

model ImpersonationLog {
  id                String    @id @default(cuid())
  impersonatorId    String    @map("impersonator_id")
  impersonatorName  String?   @map("impersonator_name")
  impersonatorEmail String?   @map("impersonator_email")
  targetUserId      String?   @map("target_user_id")
  targetStoreId     String    @map("target_store_id")
  storeName         String?   @map("store_name")
  tipo              String    @default("START") // START | REVERT
  createdAt         DateTime  @default(now()) @map("created_at")
  endedAt           DateTime? @map("ended_at")

  @@index([targetStoreId, createdAt])
  @@map("impersonation_logs")
}

model ClientUser {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  userId    String   @map("user_id")
  // Roles: 'OWNER' | 'ADMIN'
  role      String   @default("OWNER")
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@map("client_users")
}

model Subscription {
  id                      String   @id @default(cuid())
  clientId                String   @map("client_id")
  planId                  String   @map("plan_id")
  valorMensalidade        Decimal  @map("valor_mensalidade") @db.Decimal(10, 2)
  dataVencimento          DateTime @map("data_vencimento") @db.Date
  // Status: 'PAGO' | 'PENDENTE' | 'VENCIDO' | 'CANCELADO'
  statusPagamento         String   @map("status_pagamento")
  bloqueioAutomaticoAtivo Boolean  @default(true) @map("bloqueio_automatico_ativo")
  mpPreapprovalId         String?  @map("mp_preapproval_id")
  mpStatus                String?  @map("mp_status")
  createdAt               DateTime @default(now()) @map("created_at")

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  cobrancaNotificacoes CobrancaNotificacao[]
  webhookEvents        WebhookEvent[]

  @@map("subscriptions")
}

// Eventos de webhook já processados (idempotência: mesmo evento entregue
// 2x não pode creditar/renovar 2x). Unique(eventId + eventType) garante
// exatamente-uma-vez mesmo em entregas concorrentes.
model WebhookEvent {
  id            String   @id @default(cuid())
  eventId        String       @map("event_id")
  eventType      String       @map("event_type")
  preapprovalId  String?      @map("preapproval_id")
  subscriptionId String?      @map("subscription_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([eventId, eventType])
  @@index([subscriptionId, createdAt])
  @@map("webhook_events")
}

model CobrancaNotificacao {
  id             String       @id @default(cuid())
  subscriptionId String       @map("subscription_id")
  // Tipo: 'LEMBRETE_1' | 'LEMBRETE_2' | 'AVISO_BLOQUEIO'
  tipo           String
  enviadaEm      DateTime     @default(now()) @map("enviada_em")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, tipo])
  @@map("cobranca_notificacoes")
}

model ScanRun {
  id           String   @id @default(cuid())
  data         DateTime @unique @map("data")
  // Origem: 'cron' | 'manual:<email>'
  disparadoPor String   @map("disparado_por")
  // Status: 'PLANEJADO' | 'EXECUTADO' | 'FALHOU'
  status       String   @default("EXECUTADO")
  plano        Json     @map("plano")
  resultado    Json?    @map("resultado")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("scan_runs")
}

model ExcecaoBloqueio {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  motivo    String
  criadoPor String   @map("criado_por")
  // NULL = permanente
  ate       DateTime?
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("excecoes_bloqueio")
}

model SaasAuditLog {
  id        String   @id @default(cuid())
  clientId  String?  @map("client_id")
  // Ação: 'MARCAR_VENCIDO' | 'NOTIFICACAO' | 'EXCECAO_BLOQUEIO' | 'VARRE_'
  acao      String
  payload   Json?
  criadoPor String   @map("criado_por")
  createdAt DateTime @default(now()) @map("created_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("saas_audit_logs")
}

model Invoice {
  id             String    @id @default(cuid())
  subscriptionId String    @map("subscription_id")
  mesReferencia  String    @map("mes_referencia") // Ex: "2023-10"
  valorCobrado   Decimal   @map("valor_cobrado") @db.Decimal(10, 2)
  // Status: 'PAGO' | 'PENDENTE' | 'VENCIDO' | 'CANCELADO'
  status         String    @default("PENDENTE")
  dataPagamento  DateTime? @map("data_pagamento")
  urlFatura      String?   @map("url_fatura")
  createdAt      DateTime  @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

// ============================================================
// HIERARQUIA DE NEGÓCIOS — Controles e Lojas
// ============================================================

model Control {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  nome      String // Ex: "Meu Controle de Estoque Matriz"
  // Tipo: 'PF' | 'PJ' | 'ESTOQUE'
  tipo      String
  status    String   @default("ATIVO")
  createdAt DateTime @default(now()) @map("created_at")

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stores Store[]

  @@map("controls")
}

model Store {
  id                       String   @id @default(cuid())
  controlId                String   @map("control_id")
  nomeFantasia             String   @map("nome_fantasia")
  cnpjCpf                  String?  @map("cnpj_cpf")
  nichoPrincipal           String?  @map("nicho_principal")
  status                   String   @default("ATIVO")
  tipoWorkspace            String   @default("PJ") @map("tipo_workspace")
  emailContato             String?  @map("email_contato")
  telefoneWhatsapp         String?  @map("telefone_whatsapp")
  chavePix                 String?  @map("chave_pix_recebimento")
  features                 String?  @map("features") @db.Text
  dashboardCards            String?  @map("dashboard_cards") @db.Text
  pixQrCodeUrl             String?  @map("pix_qrcode_url")
  aliquotaImposto          Decimal? @default(0) @map("aliquota_imposto") @db.Decimal(5, 2)
  whatsappApiUrl           String?  @map("whatsapp_api_url")
  whatsappApiKey           String?  @map("whatsapp_api_key")
  whatsappEnabled          Boolean  @default(false) @map("whatsapp_enabled")
  whatsappSendConfirmation Boolean  @default(false) @map("whatsapp_send_confirmation")
  whatsappSendReminder     Boolean  @default(false) @map("whatsapp_send_reminder")
  whatsappSendBirthday     Boolean  @default(false) @map("whatsapp_send_birthday")
  whatsappSendMarketing    Boolean  @default(false) @map("whatsapp_send_marketing")
  cartaoImediato           Boolean  @default(true) @map("cartao_imediato")
  diaInicioMes             Int      @default(1) @map("dia_inicio_mes")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  control Control @relation(fields: [controlId], references: [id], onDelete: Cascade)

  storeUsers            StoreUserAccess[]
  customers             Customer[]
  products              Product[]
  categories            Category[]
  brands                Brand[]
  sales                 Sale[]
  wallets               Wallet[]
  financialTransactions FinancialTransaction[]
  cashRegisters         CashRegister[]
  accountPayables       AccountPayable[]
  auditLogs             AuditLog[]
  supportTickets        SupportTicket[]
  commissionRules       CommissionRule[]
  accountsReceivable    AccountReceivable[]
  paymentMethodFees     PaymentMethodFee[]
  productEntries        ProductEntry[]
  stockMovements        StockMovement[]
  quotes                Quote[]
  purchaseOrders        PurchaseOrder[]
  productReturns        ProductReturn[]
  commissionPayments    CommissionPayment[]
  suppliers             Supplier[]
  stockTransfersOrig    StockTransfer[]        @relation("originStore")
  stockTransfersDest    StockTransfer[]        @relation("destinationStore")
  inventoryCounts       InventoryCount[]
  messageLogs           MessageLog[]
  whatsAppTemplates     WhatsAppTemplate[]
  serviceTypes          ServiceType[]
  serviceOrders         ServiceOrder[]
  professionals         Professional[]
  appointments          Appointment[]
  creditCards           CreditCard[]

  @@map("stores")
}

// ============================================================
// USERS — Usuários do sistema (Dono, Vendedor, Caixas, Super Admin)
// ============================================================

model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  // Global Roles: 'SUPER_ADMIN' | 'USER'
  role      String   @default("USER")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  internalRoleId       String?  @map("internal_role_id")
  expiresAt            DateTime? @map("expires_at")
  twoFactorEnabled     Boolean  @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?  @map("two_factor_secret")
  billingCycleStartDay Int      @default(1) @map("billing_cycle_start_day")
  monthlyBudgetLimit   Decimal? @map("monthly_budget_limit") @db.Decimal(12, 2)
  resetToken           String?  @map("reset_token")
  resetTokenExpires    DateTime? @map("reset_token_expires")
  emailVerifiedAt      DateTime? @map("email_verified_at")
  emailVerificationRequired Boolean @default(false) @map("email_verification_required")
  emailVerifyToken     String?  @map("email_verify_token")
  emailVerifyTokenExpires DateTime? @map("email_verify_token_expires")
  lastLogin            DateTime? @map("last_login")
  lastLoginIp          String?  @map("last_login_ip")
  lastActivityAt       DateTime? @map("last_activity_at")
  loginAttempts        Int      @default(0) @map("login_attempts")
  lockoutUntil         DateTime? @map("lockout_until")
  tokenVersion         Int      @default(0) @map("token_version")

  clientAccess         ClientUser[]
  storeAccess          StoreUserAccess[]
  sales                Sale[]
  cashRegisters        CashRegister[]
  auditLogs            AuditLog[]
  commissionRules      CommissionRule[]
  stockMovements       StockMovement[]
  quotes               Quote[]
  purchaseOrders       PurchaseOrder[]
  productReturns       ProductReturn[]
  commissionPayments   CommissionPayment[]
  stockTransfers       StockTransfer[]
  serviceOrders        ServiceOrder[]
  inventoryCounts      InventoryCount[]
  internalRole         InternalRole?         @relation(fields: [internalRoleId], references: [id])
  personalCategories   PersonalCategory[]
  personalTransactions PersonalTransaction[]
  personalBudgets      PersonalBudget[]
  personalWallets      PersonalWallet[]

  @@map("users")
}

model InternalRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  clientId    String?  @map("client_id")
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions InternalRolePermission[]

  @@map("internal_roles")
}

model InternalRolePermission {
  id          String       @id @default(cuid())
  roleId      String       @map("role_id")
  role        InternalRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module      String // ex: CLIENTES, FINANCEIRO, CHAMADOS, AUDITORIA
  accessLevel String       @map("access_level") // FULL, VIEW, NONE
  actions     String[]     @default([]) // create, read, update, delete (granular)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([roleId, module])
  @@map("internal_role_permissions")
}

model StoreUserAccess {
  id                   String   @id @default(cuid())
  storeId              String   @map("store_id")
  userId               String   @map("user_id")
  // Roles na loja: 'ADMIN_LOJA' | 'VENDEDOR' | 'CAIXA'
  role                 String   @default("VENDEDOR")
  permiteVendaPrazo    Boolean  @default(false) @map("permite_venda_prazo")
  limiteDescontoMaximo Decimal  @default(0) @map("limite_desconto_maximo") @db.Decimal(5, 2)
  createdAt            DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@map("store_user_access")
}

// ============================================================
// OPERACIONAL DA LOJA — Customers, Products, Sales, etc.
// ============================================================

model Customer {
  id                     String   @id @default(cuid())
  storeId                String   @map("store_id")
  nomeCompleto           String   @map("nome_completo")
  cpf                    String?
  telefoneWhatsapp       String?  @map("telefone_whatsapp")
  cep                    String?
  enderecoCompleto       String?  @map("endereco_completo")
  email                  String?
  rg                     String?
  dataNascimento         String?  @map("data_nascimento")
  observacoes            String?
  aceitaMarketing        Boolean  @default(true) @map("aceita_marketing")
  aceitaLembreteCobranca Boolean  @default(true) @map("aceita_lembrete_cobranca")
  portalToken            String?  @unique @map("portal_token")
  createdAt              DateTime @default(now()) @map("created_at")

  store                 Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales                 Sale[]
  receivables           AccountReceivable[]
  financialTransactions FinancialTransaction[]
  quotes                Quote[]
  productReturns        ProductReturn[]
  messageLogs           MessageLog[]
  serviceOrders         ServiceOrder[]
  appointments          Appointment[]
  purchaseOrders        PurchaseOrder[]

  @@map("customers")
}

model Category {
  id                String   @id @default(cuid())
  storeId           String   @map("store_id")
  nome              String
  corHexadecimal    String?  @map("cor_hexadecimal")
  margemLucroPadrao Decimal? @map("margem_lucro_padrao") @db.Decimal(5, 2)
  aliquotaImposto   Decimal? @map("aliquota_imposto") @db.Decimal(5, 2)

  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products        Product[]
  commissionRules CommissionRule[]

  @@map("categories")
}

model Brand {
  id      String @id @default(cuid())
  storeId String @map("store_id")
  nome    String

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("brands")
}

model PaymentMethodFee {
  id               String  @id @default(cuid())
  storeId          String  @map("store_id")
  formaPagamento   String  @map("forma_pagamento") // 'PIX', 'CARTAO_CREDITO', 'CARTAO_DEBITO', etc.
  parcelas         Int     @default(1)
  taxaPercentual   Decimal @default(0) @map("taxa_percentual") @db.Decimal(5, 2)
  taxaFixa         Decimal @default(0) @map("taxa_fixa") @db.Decimal(10, 2)
  prazoRecebimento Int     @default(0) @map("prazo_recebimento_dias")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, formaPagamento, parcelas])
  @@map("payment_method_fees")
}

model ProductEntry {
  id                 String   @id @default(cuid())
  storeId            String   @map("store_id")
  dataEntrada        DateTime @default(now()) @map("data_entrada")
  fornecedor         String?
  supplierId         String?  @map("supplier_id")
  valorTotalProdutos Decimal  @map("valor_total_produtos") @db.Decimal(10, 2)
  valorFreteTotal    Decimal  @map("valor_frete_total") @db.Decimal(10, 2)
  valorOutrosCustos  Decimal  @default(0) @map("valor_outros_custos") @db.Decimal(10, 2)

  store    Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier?          @relation(fields: [supplierId], references: [id])
  items    ProductEntryItem[]

  @@map("product_entries")
}

model ProductEntryItem {
  id                 String  @id @default(cuid())
  productEntryId     String  @map("product_entry_id")
  productId          String  @map("product_id")
  quantidade         Decimal @db.Decimal(10, 3)
  custoFornecedor    Decimal @map("custo_fornecedor") @db.Decimal(10, 2)
  freteRateado       Decimal @map("frete_rateado") @db.Decimal(10, 2)
  custoUnitarioFinal Decimal @map("custo_unitario_final") @db.Decimal(10, 2)

  entry   ProductEntry @relation(fields: [productEntryId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_entry_items")
}

model Product {
  id                        String    @id @default(cuid())
  storeId                   String    @map("store_id")
  categoryId                String    @map("category_id")
  codigoBarrasEan           String?   @map("codigo_barras_ean")
  codigoVisual              String?   @map("codigo_visual")
  nome                      String
  descricaoVariante         String?   @map("descricao_variante")
  ncm                       String?   @map("ncm")
  unidade                   String    @default("UN") @map("unidade") // UN, KG, M, CX, PC, LT, etc.
  pesoBruto                 Decimal?  @map("peso_bruto") @db.Decimal(10, 3)
  pesoLiquido               Decimal?  @map("peso_liquido") @db.Decimal(10, 3)
  precoCusto                Decimal   @map("preco_custo") @db.Decimal(10, 2)
  precoVendaSugerido        Decimal   @map("preco_venda_sugerido") @db.Decimal(10, 2)
  impostoEstimadoPercentual Decimal   @default(0) @map("imposto_estimado_percentual") @db.Decimal(5, 2)
  qtdEstoqueAtual           Decimal   @map("qtd_estoque_atual") @db.Decimal(10, 3)
  estoqueMinimo             Decimal   @default(5) @map("estoque_minimo") @db.Decimal(10, 3)
  imageUrl                  String?   @map("image_url") @db.Text
  // Status: 'ATIVO' | 'INATIVO' | 'SEM_ESTOQUE' | 'ENCOMENDA'
  status                    String    @default("ATIVO")
  dataPedido                DateTime? @map("data_pedido")
  previsaoChegada           DateTime? @map("previsao_chegada")

  brandId String? @map("brand_id")

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category            Category             @relation(fields: [categoryId], references: [id])
  brand               Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  saleItems           SaleItem[]
  entryItems          ProductEntryItem[]
  stockMovements      StockMovement[]
  quoteItems          QuoteItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  productReturnItems  ProductReturnItem[]
  stockTransferItems  StockTransferItem[]
  inventoryCountItems InventoryCountItem[]
  serviceOrderItems   ServiceOrderItem[]

  @@map("products")
}

model StockMovement {
  id             String   @id @default(cuid())
  storeId        String   @map("store_id")
  productId      String   @map("product_id")
  userId         String   @map("user_id")
  tipo           String // ENTRADA (compra/ajuste+), SAIDA (venda/ajuste-), AJUSTE, TRANSFERENCIA_ORIGEM, TRANSFERENCIA_DESTINO
  quantidade     Decimal  @db.Decimal(10, 3)
  saldoAnterior  Decimal  @map("saldo_anterior") @db.Decimal(10, 3)
  saldoPosterior Decimal  @map("saldo_posterior") @db.Decimal(10, 3)
  referenciaId   String?  @map("referencia_id") // saleId, productEntryId, stockTransferId
  motivo         String? // PERDA, QUEBRA, ROUBO, ERRO_CONTAGEM, DEVOLUCAO, OUTRO (para ajustes)
  observacao     String?
  createdAt      DateTime @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("stock_movements")
}

model StockTransfer {
  id                 String   @id @default(cuid())
  originStoreId      String   @map("origin_store_id")
  destinationStoreId String   @map("destination_store_id")
  userId             String   @map("user_id")
  status             String   @default("PENDENTE") // PENDENTE, ENVIADO, RECEBIDO, CANCELADO
  observacao         String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  originStore      Store               @relation("originStore", fields: [originStoreId], references: [id], onDelete: Cascade)
  destinationStore Store               @relation("destinationStore", fields: [destinationStoreId], references: [id])
  user             User                @relation(fields: [userId], references: [id])
  items            StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id                 String  @id @default(cuid())
  stockTransferId    String  @map("stock_transfer_id")
  productId          String  @map("product_id")
  quantidade         Decimal @db.Decimal(10, 3)
  quantidadeRecebida Decimal @default(0) @map("quantidade_recebida") @db.Decimal(10, 3)

  transfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@map("stock_transfer_items")
}

model InventoryCount {
  id           String   @id @default(cuid())
  storeId      String   @map("store_id")
  userId       String   @map("user_id")
  dataContagem DateTime @default(now()) @map("data_contagem")
  status       String   @default("ABERTO") // ABERTO, FINALIZADO, CONCILIADO
  observacao   String?  @db.Text
