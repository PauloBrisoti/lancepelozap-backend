[Unit]
Description=Redis (rate limiting distribuído — SaaS)
After=network.target

[Service]
Type=simple
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/redis/redis.conf
# Sem ExecStop: systemd envia SIGTERM e o Redis persiste (AOF/RDB) no shutdown
Restart=always
RestartSec=3

# --- Hardening do processo ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/redis
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
