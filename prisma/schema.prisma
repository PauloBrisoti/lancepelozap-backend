model Sale {
  id                String    @id @default(cuid())
  storeId           String    @map("store_id")
  cashRegisterId    String?   @map("cash_register_id")
  userId            String    @map("user_id") // Vendedor
  customerId        String?   @map("customer_id")
  dataVenda         DateTime  @default(now()) @map("data_venda")
  valorTotalBruto   Decimal   @map("valor_total_bruto") @db.Decimal(10, 2)
  valorDesconto     Decimal   @default(0) @map("valor_desconto") @db.Decimal(10, 2)
  valorTotalLiquido Decimal   @map("valor_total_liquido") @db.Decimal(10, 2)
  // Forma de pagamento: 'PIX' | 'CARTAO' | 'CREDIARIO' | 'DINHEIRO'
  formaPagamento    String    @default("PIX") @map("forma_pagamento")
  valorSinal        Decimal   @default(0) @map("valor_sinal") @db.Decimal(10, 2)
  numeroParcelas    Int       @default(1) @map("numero_parcelas")
  // Taxas e CMV
  valorTaxasGateway Decimal   @default(0) @map("valor_taxas_gateway") @db.Decimal(10, 2)
  cmvTotal          Decimal   @default(0) @map("cmv_total") @db.Decimal(10, 2)
  // Status: 'FINALIZADA' | 'PENDENTE' | 'CANCELADA'
  status            String    @default("FINALIZADA")
