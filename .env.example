# ============================================================
# .env.example — SaaS Gestão Modular — Backend
# Copie para .env e preencha com os valores reais
# NUNCA commite o .env no git!
# ============================================================

# --- Banco de Dados (PostgreSQL) ---
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL="postgresql://saas_admin:SUA_SENHA@localhost:5432/saas_db"

# --- Autenticação JWT ---
# Gere: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# --- Servidor ---
PORT=3001
NODE_ENV=production

# --- Cloudflare R2 (Storage) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="saas-comprovantes"
R2_PUBLIC_URL=""

# --- Mercado Pago ---
MP_ACCESS_TOKEN=""
# Segredo do webhook (painel MP > Suas integrações > Notificações/Webhooks).
# Necessário para validar a assinatura das notificações de pagamento/assinatura.
MP_WEBHOOK_SECRET=""

# --- SMTP (Hostinger) ---
# Porta 465 (SSL) ou 587 (TLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@lancepelozap.com.br
SMTP_PASS=
SMTP_FROM=contato@lancepelozap.com.br

# --- Google Gemini AI ---
GEMINI_API_KEY=""

# --- Super Admin ---
SUPER_ADMIN_SECRET=""

# --- Rate Limiting Distribuído (Redis) ---
# Obrigatório em produção com múltiplas instâncias. Se ausente, o servidor usa
# fallback in-memory (proteção degradada por instância — fail-safe).
REDIS_URL="redis://127.0.0.1:6379"

# --- Observabilidade: query logging ---
# Queries do Prisma acima deste tempo (ms) viram log warn + slow query nas métricas.
# Abaixo disso, todas as queries são logadas em debug com duração.
QUERY_SLOW_MS="500"

# --- Observabilidade: alertas de anomalias ---
# Webhook genérico (Slack/Teams/healthchecks.io). Vazio = alertas desabilitados
# (apenas logs warn). Dedupe por chave com cooldown; watchdog varre métricas
# a cada ALERT_WATCHDOG_MS e dispara em: 5xx%, memória, CPU, event loop, slow queries.
ALERT_WEBHOOK_URL=""
# ALERT_WEBHOOK_HEADERS='{"Authorization":"Bearer x"}'   # opcional
# ALERT_COOLDOWN_MS="300000"      # cooldown entre alertas da mesma chave
# ALERT_WATCHDOG_MS="60000"       # intervalo do watchdog
# ALERT_5XX_RATE_PERCENT="10"     # % de 5xx na janela
# ALERT_MEMORY_PERCENT="85"       # % de heap usado
# ALERT_CPU_PERCENT="85"          # % CPU na janela
# ALERT_EVENTLOOP_MS="200"        # event loop lag
# ALERT_SLOW_QUERY_MS="500"       # query acima disso conta como lenta
# ALERT_SLOW_QUERY_MIN="5"        # mínimo de lentas para alertar

# --- Observabilidade: versão ---
# Commit do build, injetado pelo deploy.sh; aparece em /health e /health/ready.
BUILD_COMMIT=""

# --- Jobs/Cron HTTP ---
# Segredo dos endpoints /api/jobs/* — exigido via "Authorization: Bearer <CRON_SECRET>"
# (comparação timing-safe). Invocações por query string são bloqueadas (400).
# Gere: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CRON_SECRET=""
