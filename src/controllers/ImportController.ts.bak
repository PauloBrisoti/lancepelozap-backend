import { Request, Response } from 'express';
import { prisma } from '../lib/prisma';
import fs from 'fs';
import csvParser from 'csv-parser';

export class ImportController {
  
  // POST /api/import/csv/clientes
  async importCustomers(req: Request, res: Response) {
    try {
      const storeId = req.user?.storeId as string;
      if (!storeId) return res.status(403).json({ error: 'Acesso negado' });

      if (!req.file) return res.status(400).json({ error: 'Arquivo CSV não fornecido' });

      const results: any[] = [];
      let successCount = 0;
      let errorCount = 0;

      fs.createReadStream(req.file.path)
        .pipe(csvParser())
        .on('data', (data) => results.push(data))
        .on('end', async () => {
          // Após parse, inserir no banco
          for (const row of results) {
            try {
              if (!row.nomeCompleto) continue; // Nome é obrigatório
              
              await prisma.customer.create({
                data: {
                  storeId,
                  nomeCompleto: row.nomeCompleto,
                  telefoneWhatsapp: row.telefoneWhatsapp || null,
                  cpf: row.cpf || null,
                  cep: row.cep || null,
                  enderecoCompleto: row.enderecoCompleto || null
                }
              });
              successCount++;
            } catch (e) {
              errorCount++;
            }
          }
          
          // Deleta o arquivo temporário
          fs.unlinkSync(req.file!.path);
          
          return res.json({ 
            message: 'Importação finalizada', 
            successCount, 
            errorCount 
          });
        });
    } catch (error) {
      console.error(error);
      return res.status(500).json({ error: 'Erro ao importar clientes' });
    }
  }

  // POST /api/import/csv/produtos
  async importProducts(req: Request, res: Response) {
    try {
      const storeId = req.user?.storeId as string;
      if (!storeId) return res.status(403).json({ error: 'Acesso negado' });

      if (!req.file) return res.status(400).json({ error: 'Arquivo CSV não fornecido' });

      // Opcional: Pegar uma categoria padrão (Geral)
      let defaultCategory = await prisma.category.findFirst({
        where: { storeId, nome: 'Geral' }
      });
      if (!defaultCategory) {
        defaultCategory = await prisma.category.create({
          data: { storeId, nome: 'Geral', corHexadecimal: '#cccccc' }
        });
      }

      const results: any[] = [];
      let successCount = 0;
      let errorCount = 0;

      fs.createReadStream(req.file.path)
        .pipe(csvParser())
        .on('data', (data) => results.push(data))
        .on('end', async () => {
          for (const row of results) {
            try {
              if (!row.nome || !row.precoVendaSugerido) continue; // Nome e preço são obrigatórios
              
              const precoVenda = parseFloat(row.precoVendaSugerido.replace(',', '.'));
              const precoCusto = row.precoCusto ? parseFloat(row.precoCusto.replace(',', '.')) : 0;
              const estoque = row.qtdEstoqueAtual ? parseFloat(row.qtdEstoqueAtual.replace(',', '.')) : 0;

              await prisma.product.create({
                data: {
                  storeId,
                  categoryId: defaultCategory!.id,
                  nome: row.nome,
                  precoVendaSugerido: precoVenda,
                  precoCusto: precoCusto,
                  qtdEstoqueAtual: estoque,
                  codigoBarrasEan: row.codigoBarrasEan || null,
                  descricaoVariante: row.descricaoVariante || null,
                  status: 'ATIVO'
                }
              });
              successCount++;
            } catch (e) {
              errorCount++;
            }
          }
          
          fs.unlinkSync(req.file!.path);
          
          return res.json({ 
            message: 'Importação finalizada', 
            successCount, 
            errorCount 
          });
        });
    } catch (error) {
      console.error(error);
      return res.status(500).json({ error: 'Erro ao importar produtos' });
    }
  }

}
