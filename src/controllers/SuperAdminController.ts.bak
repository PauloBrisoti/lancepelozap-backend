import { Request, Response } from 'express';
import { prisma } from '../lib/prisma';
import bcrypt from 'bcryptjs';

export class SuperAdminController {

  // ==========================================
  // DASHBOARD SUPER ADMIN
  // ==========================================

  async getDashboard(req: Request, res: Response) {
    try {
      if (req.user?.role !== 'SUPER_ADMIN') {
        return res.status(403).json({ error: 'Acesso negado. Apenas SUPER_ADMIN.' });
      }

      const totalTenants = await prisma.store.count();
      const totalUsers = await prisma.user.count();

      const totalRevenueAggr = await prisma.sale.aggregate({
        _sum: { valorTotalLiquido: true },
        where: { status: 'FINALIZADA' }
      });

      const totalPendingReceivablesAggr = await prisma.accountReceivable.aggregate({
        _sum: { valorParcela: true },
        where: { status: 'PENDENTE' }
      });

      // Top Lojas por faturamento
      const topTenantsAggr = await prisma.sale.groupBy({
        by: ['storeId'],
        _sum: { valorTotalLiquido: true },
        where: { status: 'FINALIZADA' },
        orderBy: { _sum: { valorTotalLiquido: 'desc' } },
        take: 5
      });

      const topTenantsList = await Promise.all(
        topTenantsAggr.map(async (t) => {
          const tenant = await prisma.store.findUnique({ where: { id: t.storeId }, select: { nomeFantasia: true } });
          return {
            storeId: t.storeId,
            nomeFantasia: tenant?.nomeFantasia || 'Desconhecido',
            faturamentoTotal: t._sum.valorTotalLiquido || 0
          };
        })
      );

      return res.json({
        totalTenants,
        totalUsers,
        totalRevenue: totalRevenueAggr._sum.valorTotalLiquido || 0,
        totalPendingReceivables: totalPendingReceivablesAggr._sum.valorParcela || 0,
        topTenants: topTenantsList,
        status: 'ok'
      });
    } catch (error) {
      console.error(error);
      return res.status(500).json({ error: 'Erro ao carregar dashboard do super admin' });
    }
  }

  // ==========================================
  // LOJAS (TENANTS)
  // ==========================================

  // Lista todos os Tenants e suas assinaturas e usuários admin
  async getAllTenants(req: Request, res: Response) {
    try {
      if (req.user?.role !== 'SUPER_ADMIN') {
        return res.status(403).json({ error: 'Acesso negado. Apenas SUPER_ADMIN.' });
      }

      const tenants = await prisma.store.findMany({
        orderBy: { createdAt: 'desc' },
        include: {
          subscriptions: true,
          users: {
            where: { role: 'ADMIN' },
            select: { id: true, nome: true, email: true, ativo: true }
          }
        }
      });

      return res.json(tenants);
    } catch (error) {
      console.error('Erro ao buscar tenants:', error);
      return res.status(500).json({ error: 'Erro ao buscar dados das lojas' });
    }
  }

  // Cria um novo Tenant manualmente
  async createTenant(req: Request, res: Response) {
    try {
      if (!req.user || req.user.role !== 'SUPER_ADMIN') {
        return res.status(403).json({ error: 'Acesso negado. Apenas SUPER_ADMIN pode criar lojas.' });
      }

      const { 
        nomeFantasia, 
        cnpjCpf, 
        nichoPrincipal, 
        telefoneWhatsapp, 
        emailContato, 
        chavePix,
        // Dados do Admin
        nomeResponsavel,
        emailResponsavel,
        senhaResponsavel,
        // Dados da assinatura
        plano,
        statusPagamento
      } = req.body;

      if (!nomeFantasia || !emailResponsavel || !senhaResponsavel) {
        return res.status(400).json({ error: 'Campos obrigatórios: Nome da Loja, Email do Responsável e Senha Inicial' });
      }

      const existingUser = await prisma.user.findUnique({ where: { email: emailResponsavel } });
      if (existingUser) {
        return res.status(400).json({ error: 'E-mail do responsável já está em uso' });
      }

      const hashedPassword = await bcrypt.hash(senhaResponsavel, 10);

      const transactionResult = await prisma.$transaction(async (tx) => {
        // Criar Tenant
        const newTenant = await tx.tenant.create({
          data: {
            nomeFantasia,
            cnpjCpf: cnpjCpf || null,
            nichoPrincipal,
            telefoneWhatsapp,
            emailContato,
            chavePix,
            status: 'ATIVO'
          }
        });

        // Criar Usuário
        const newUser = await tx.user.create({
          data: {
            email: emailResponsavel,
            senhaHash: hashedPassword,
            nome: nomeResponsavel || 'Admin',
            role: 'ADMIN',
            storeId: newTenant.id
          }
        });

        // Criar Assinatura
        const validade = new Date();
        validade.setMonth(validade.getMonth() + 1); // 1 mês

        const newSubscription = await tx.subscription.create({
          data: {
            storeId: newTenant.id,
            plano: plano || 'STARTER',
            valorMensalidade: plano === 'PRO' ? 199 : plano === 'ENTERPRISE' ? 499 : 49,
            dataVencimento: validade,
            statusPagamento: statusPagamento || 'PAGO'
          }
        });

        return { newTenant, newUser, newSubscription };
      });

      return res.status(201).json(transactionResult);
    } catch (error) {
      console.error('Erro ao criar tenant pelo super admin:', error);
      return res.status(500).json({ error: 'Erro ao registrar loja' });
    }
  }

  // Atualiza um Tenant
  async updateTenant(req: Request, res: Response) {
    try {
      if (req.user?.role !== 'SUPER_ADMIN') {
        return res.status(403).json({ error: 'Acesso negado' });
      }

      const id = req.params.id as string;
      const { nomeFantasia, cnpjCpf, nichoPrincipal, telefoneWhatsapp, emailContato, chavePix, status } = req.body;

      const updatedTenant = await prisma.store.update({
        where: { id },
        data: {
          nomeFantasia,
          cnpjCpf,
          nichoPrincipal,
          telefoneWhatsapp,
          emailContato,
          chavePix,
          status
        }
      });

      return res.json(updatedTenant);
    } catch (error) {
      console.error('Erro ao atualizar tenant:', error);
      return res.status(500).json({ error: 'Erro ao atualizar dados da loja' });
    }
  }

  // Lista todos os usuários de um Tenant
  async getTenantUsers(req: Request, res: Response) {
    try {
      if (req.user?.role !== 'SUPER_ADMIN') {
        return res.status(403).json({ error: 'Acesso negado' });
      }

      const id = req.params.id as string; // storeId

      const users = await prisma.user.findMany({
        where: { storeId: id },
        select: { id: true, nome: true, email: true, role: true, ativo: true, permiteVendaPrazo: true }
      });

      return res.json(users);
    } catch (error) {
      console.error('Erro ao listar usuários do tenant:', error);
      return res.status(500).json({ error: 'Erro ao listar funcionários' });
    }
  }

  // ==========================================
  // CONFIGURAÇÕES GLOBAIS (WHITE-LABEL)
  // ==========================================

  async getSystemSettings(req: Request, res: Response) {
    try {
      if (req.user?.role !== 'SUPER_ADMIN') return res.status(403).json({ error: 'Acesso negado' });
      
      const settings = await prisma.systemSetting.findMany();
      return res.json(settings);
    } catch (error) {
      return res.status(500).json({ error: 'Erro ao buscar configurações' });
    }
  }

  async updateSystemSettings(req: Request, res: Response) {
    try {
      if (req.user?.role !== 'SUPER_ADMIN') return res.status(403).json({ error: 'Acesso negado' });
      
      const { settings } = req.body; // Array de { chave, valor, descricao }
      
      for (const s of settings) {
        await prisma.systemSetting.upsert({
          where: { chave: s.chave },
          update: { valor: s.valor, descricao: s.descricao },
          create: { chave: s.chave, valor: s.valor, descricao: s.descricao }
        });
      }
      
      return res.json({ message: 'Configurações atualizadas' });
    } catch (error) {
      return res.status(500).json({ error: 'Erro ao salvar configurações' });
    }
  }

  // ==========================================
  // BACKUPS DE SEGURANÇA
  // ==========================================

  async triggerBackup(req: Request, res: Response) {
    try {
      if (req.user?.role !== 'SUPER_ADMIN') return res.status(403).json({ error: 'Acesso negado' });
      
      const { exec } = require('child_process');
      const backupFile = `backup-${Date.now()}.sql`;
      const cmd = `pg_dump ${process.env.DATABASE_URL} > uploads/${backupFile}`;
      
      exec(cmd, (error: any, stdout: any, stderr: any) => {
        if (error) {
          console.error(`Erro no backup: ${error.message}`);
          return res.status(500).json({ error: 'Falha ao executar backup', details: error.message });
        }
        return res.json({ message: 'Backup concluído com sucesso', file: backupFile });
      });
      
    } catch (error) {
      return res.status(500).json({ error: 'Erro ao iniciar backup' });
    }
  }

  // ==========================================
  // LOGS DE AUDITORIA
  // ==========================================

  async getAuditLogs(req: Request, res: Response) {
    try {
      if (req.user?.role !== 'SUPER_ADMIN') return res.status(403).json({ error: 'Acesso negado' });
      
      const logs = await prisma.auditLog.findMany({
        orderBy: { createdAt: 'desc' },
        take: 100, // Limite inicial
        include: { user: { select: { nome: true, email: true } }, tenant: { select: { nomeFantasia: true } } }
      });
      
      return res.json(logs);
    } catch (error) {
      return res.status(500).json({ error: 'Erro ao buscar logs' });
    }
  }

  // ==========================================
  // IMPERSONATION (God Mode)
  // ==========================================

  // Entra no painel da loja selecionada (Impersonate)
  async impersonate(req: Request, res: Response) {
    try {
      if (!req.user || req.user.role !== 'SUPER_ADMIN') {
        return res.status(403).json({ error: 'Acesso negado. Apenas SUPER_ADMIN.' });
      }

      const { storeId } = req.params;
      const tenant = await prisma.store.findUnique({ where: { id: storeId } });
      if (!tenant) return res.status(404).json({ error: 'Loja não encontrada' });

      const JWT_SECRET = process.env.JWT_SECRET;
      if (!JWT_SECRET) return res.status(500).json({ error: 'JWT_SECRET ausente' });

      // Gera um novo token que tem o role SUPER_ADMIN, mas com o storeId alvo
      // e uma flag isImpersonating para podermos reverter.
      const jwt = require('jsonwebtoken');
      const token = jwt.sign(
        { 
          id: req.user.id, 
          storeId: storeId,
          role: 'SUPER_ADMIN', 
          isImpersonating: true,
          originalUserId: req.user.id,
          originalTenantId: req.user.storeId
        },
        JWT_SECRET,
        { expiresIn: "1d" }
      );

      res.cookie("authToken", token, {
        httpOnly: true,
        sameSite: "lax",
        secure: process.env.NODE_ENV === "production",
        maxAge: 24 * 60 * 60 * 1000,
      });

      return res.json({ message: "Login na loja efetuado com sucesso" });
    } catch (error) {
      console.error('Erro ao acessar painel da loja:', error);
      return res.status(500).json({ error: "Erro ao acessar painel da loja" });
    }
  }

  // Volta para a sessão normal de Super Admin
  async revertImpersonation(req: Request, res: Response) {
    try {
      if (!req.user?.isImpersonating) {
        return res.status(400).json({ error: 'Você não está em modo de acesso a cliente' });
      }

      const originalUser = await prisma.user.findUnique({ where: { id: req.user.originalUserId } });
      if (!originalUser) return res.status(404).json({ error: 'Usuário original não encontrado' });

      const JWT_SECRET = process.env.JWT_SECRET;
      if (!JWT_SECRET) return res.status(500).json({ error: 'JWT_SECRET ausente' });

      const jwt = require('jsonwebtoken');
      const token = jwt.sign(
        { 
          id: originalUser.id, 
          storeId: originalUser.storeId,
          role: originalUser.role 
        },
        JWT_SECRET,
        { expiresIn: "7d" }
      );

      res.cookie("authToken", token, {
        httpOnly: true,
        sameSite: "lax",
        secure: process.env.NODE_ENV === "production",
        maxAge: 7 * 24 * 60 * 60 * 1000,
      });

      return res.json({ message: "Sessão de Super Admin restaurada com sucesso" });
    } catch (error) {
      console.error('Erro ao reverter sessão:', error);
      return res.status(500).json({ error: "Erro ao reverter sessão" });
    }
  }

}
