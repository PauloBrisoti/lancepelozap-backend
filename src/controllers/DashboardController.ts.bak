import { Request, Response } from 'express';
import { prisma } from '../lib/prisma';

export class DashboardController {
  
  // Dashboard Lojista (Tenant)
  static async getTenantDashboard(req: Request, res: Response) {
    try {
      const storeId = req.user?.storeId as string;
      if (!storeId) return res.status(401).json({ message: 'Não autorizado' });

      // 1. Vendas de Hoje
      const hoje = new Date();
      hoje.setHours(0, 0, 0, 0);

      const vendasHoje = await prisma.sale.findMany({
        where: {
          storeId,
          dataVenda: {
            gte: hoje
          }
        }
      });

      const totalVendasHoje = vendasHoje.reduce((acc, sale) => acc + Number(sale.valorTotal), 0);
      const qtdPedidosHoje = vendasHoje.length;
      const ticketMedioHoje = qtdPedidosHoje > 0 ? totalVendasHoje / qtdPedidosHoje : 0;

      // 2. Alertas de Estoque (produtos com quantidade <= estoque minimo)
      const produtosEstoqueBaixo = await prisma.product.findMany({
        where: {
          storeId,
          qtdEstoqueAtual: {
            lte: 5 // Default threshold
          }
        },
        select: {
          id: true,
          nome: true,
          qtdEstoqueAtual: true
        }
      });

      // 3. Últimas 5 vendas
      const ultimasVendas = await prisma.sale.findMany({
        where: { storeId },
        orderBy: { dataVenda: 'desc' },
        take: 5,
        include: {
          customer: true
        }
      });

      return res.status(200).json({
        vendasHoje: totalVendasHoje,
        pedidosHoje: qtdPedidosHoje,
        ticketMedio: ticketMedioHoje,
        estoqueBaixoCount: produtosEstoqueBaixo.length,
        produtosEstoqueBaixo,
        ultimasVendas: ultimasVendas.map(v => ({
          id: v.id,
          data: v.dataVenda,
          cliente: v.customer?.nomeCompleto || 'Cliente Avulso',
          pagamento: v.formaPagamento,
          valor: Number(v.valorTotal)
        }))
      });
    } catch (error) {
      console.error('Erro no Dashboard Tenant:', error);
      return res.status(500).json({ message: 'Erro interno' });
    }
  }

  // Dashboard Super ADM
  static async getSuperAdmDashboard(req: Request, res: Response) {
    try {
      const role = req.user?.role;
      if (role !== 'SUPER_ADMIN') {
        return res.status(403).json({ message: 'Acesso negado. Apenas SUPER_ADMIN.' });
      }

      // Lojas (Tenants)
      const totalTenants = await prisma.store.count();
      
      // Assinaturas ativas e MRR
      const assinaturasAtivas = await prisma.subscription.findMany({
        where: { statusPagamento: 'PAGO' } // Simplificado para MRR
      });

      const mrr = assinaturasAtivas.reduce((acc, sub) => acc + Number(sub.valorMensalidade), 0);

      // Inadimplentes
      const inadimplentesCount = await prisma.subscription.count({
        where: { statusPagamento: 'VENCIDO' }
      });

      return res.status(200).json({
        totalLojas: totalTenants,
        lojasAtivas: totalTenants,
        mrr,
        inadimplentes: inadimplentesCount
      });
    } catch (error) {
      console.error('Erro no Dashboard Super ADM:', error);
      return res.status(500).json({ message: 'Erro interno' });
    }
  }
}
